# Copy to .env and fill in. .env is gitignored and must never be committed.

# Base Sepolia, chain 84532. Public endpoint; swap for a provider URL if rate limited.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer key for Base Sepolia only. Use a throwaway account that holds nothing
# but testnet ETH. Never a key that controls real funds.
DEPLOYER_PRIVATE_KEY=

# Optional. Only needed to verify source on the explorer after deploying.
BASESCAN_API_KEY=
